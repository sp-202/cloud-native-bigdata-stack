// Grafana Alloy -- the single node agent. Rendered into ConfigMap kube-system/alloy-config by
// charts/monitoring/templates/alloy-config.yaml and run by the `alloy` subchart as a DaemonSet.
//
// Pipelines (each section below):
//   1. pod logs            -> Loki   (replaces Promtail; labels kept identical)
//   2. systemd journal     -> Loki
//   3. Spark GC/diag files -> Loki   (node NVMe; the raw files also go to S3 via spark-node-log-shipper)
//   4. Hubble flows        -> Loki (non-FORWARDED only) + per-verdict counters -> Prometheus
//   5. OTLP (Comet)        -> Prometheus
//   6. Alloy's own metrics -> Prometheus (delivery health: dropped/failed entries, WAL lag)
//   7. node-exporter, Cilium agent and Hubble metrics, scraped on this node -> Prometheus
//
// Env from the pod spec: NODE_NAME (spec.nodeName), HOST_IP (status.hostIP).
//
// Karpenter removes a spark node ~180 s after its last executor exits. Everything here ships
// continuously (Loki batch_wait 1s, remote-write WAL on hostPath), so nothing depends on the
// SIGTERM flush; that is only the backstop, inside kubelet's 60 s critical-pod window.

// -------------------------------------------------------------------------------- 1. pod logs

// Pods on THIS node only. NODE_NAME, not HOSTNAME: with hostNetwork, HOSTNAME is the short host
// name (ip-10-0-2-41) and never matches spec.nodeName (ip-10-0-2-41.<region>.compute.internal),
// which would select no pods at all.
//
// Terminal pods stay in this list as long as their objects exist, so a finished executor's file
// is read to the end -- provided the pod is not deleted first. The Spark jobs set
// spark.kubernetes.executor.deleteOnTermination=false for exactly that reason: deleting the pod
// removes /var/log/pods/<pod>/ and drops the target, losing any unread tail.
discovery.kubernetes "pods" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_controller_name"]
		regex         = "([0-9a-z-.]+?)(-[0-9a-f]{8,10})?"
		target_label  = "__tmp_controller_name"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app", "__tmp_controller_name", "__meta_kubernetes_pod_name"]
		regex         = "^;*([^;]+)(;.*)?$"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance", "__meta_kubernetes_pod_label_instance"]
		regex         = "^;*([^;]+)(;.*)?$"
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component", "__meta_kubernetes_pod_label_component"]
		regex         = "^;*([^;]+)(;.*)?$"
		target_label  = "component"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node_name"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["namespace", "app"]
		separator     = "/"
		target_label  = "job"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}

	// Static pods: the log directory is keyed by the config hash, not the API UID.
	rule {
		source_labels = ["__meta_kubernetes_pod_annotationpresent_kubernetes_io_config_hash", "__meta_kubernetes_pod_annotation_kubernetes_io_config_hash", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		regex         = "true/(.*)"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_spark_role"]
		target_label  = "spark_role"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_spark_app_selector"]
		target_label  = "spark_app_selector"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_tier"]
		target_label  = "tier"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_ip"]
		target_label  = "pod_ip"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_host_ip"]
		target_label  = "host_ip"
	}
}

loki.source.file "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.process.pods.receiver]

	file_match {
		enabled = true
	}
}

loki.process "pods" {
	forward_to = [loki.write.default.receiver]

	stage.cri { }

	// max_wait_time flushes a buffered multiline block after 3 s of silence -- without it the
	// last block of a pod that just exited would wait for a next line that never comes.
	stage.match {
		selector = "{spark_role=~\"driver|executor\"}"

		stage.multiline {
			firstline     = "^(\\{|\\d{2}/\\d{2}/\\d{2})"
			max_wait_time = "3s"
		}
	}

	stage.match {
		selector = "{app=\"spark-history-server\"}"

		stage.multiline {
			firstline     = "^\\d{2}/\\d{2}/\\d{2}"
			max_wait_time = "3s"
		}
	}

	stage.match {
		selector = "{tier=\"airflow\"}"

		stage.multiline {
			firstline     = "^\\[\\d{4}-\\d{2}-\\d{2}"
			max_wait_time = "3s"
		}
	}

	stage.match {
		selector = "{app=\"gravitino-helm\"}"

		stage.multiline {
			firstline     = "^\\d{4}-\\d{2}-\\d{2}"
			max_wait_time = "3s"
		}
	}

	// Log level, from whichever of the platform's log formats the line is in.
	stage.regex {
		expression = "^\\S+[ T]\\S+ +(?P<level>TRACE|DEBUG|INFO|WARN|WARNING|ERROR|FATAL)\\b"
	}

	stage.regex {
		expression = "^\\[[^\\]]+\\] \\{[^}]*\\} (?P<level>[A-Z]+) - "
	}

	stage.regex {
		expression = "^\\d{2}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2} (?P<level>[A-Z]+) "
	}

	stage.regex {
		expression = "^(?P<level>[IWEF])\\d{4} \\d{2}:\\d{2}:\\d{2}"
	}

	stage.regex {
		expression = "^\\[\\d{4}/\\d{2}/\\d{2} [\\d:]+\\] \\[ *(?P<level>[a-z]+)\\]"
	}

	stage.regex {
		expression = "^\\S+ \\[(?P<level>[a-z]+) *\\] "
	}

	stage.regex {
		expression = "(?:^|\\s)level=(?P<level>[A-Za-z]+)"
	}

	stage.regex {
		expression = "\"(?:level|severity|lvl|levelname)\"\\s*:\\s*\"(?P<level>[A-Za-z]+)\""
	}

	stage.match {
		selector = "{app=\"k8s-event-exporter\"}"

		stage.json {
			expressions = {
				event_kind      = "involvedObject.kind",
				event_namespace = "involvedObject.namespace",
				event_reason    = "reason",
				level           = "type",
			}
		}

		stage.labels {
			values = {
				event_kind      = null,
				event_namespace = null,
				event_reason    = null,
			}
		}
	}

	stage.replace {
		expression = "(?i)^(t|trace)$"
		source     = "level"
		replace    = "trace"
	}

	stage.replace {
		expression = "(?i)^(d|debug)$"
		source     = "level"
		replace    = "debug"
	}

	stage.replace {
		expression = "(?i)^(i|info|information|notice|normal)$"
		source     = "level"
		replace    = "info"
	}

	stage.replace {
		expression = "(?i)^(w|warn|warning)$"
		source     = "level"
		replace    = "warn"
	}

	stage.replace {
		expression = "(?i)^(e|err|error)$"
		source     = "level"
		replace    = "error"
	}

	stage.replace {
		expression = "(?i)^(f|fatal|crit|critical|panic|alert|emerg)$"
		source     = "level"
		replace    = "fatal"
	}

	stage.labels {
		values = {
			level = null,
		}
	}
}

// -------------------------------------------------------------------------------- 2. journal

// /run/log/journal: the AMI keeps the journal volatile, and the persistent /var/log/journal
// is empty.
discovery.relabel "journal" {
	targets = []

	rule {
		source_labels = ["__journal__hostname"]
		regex         = "(.+)"
		target_label  = "node_name"
		replacement   = "$1.ap-south-1.compute.internal"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "syslog_identifier"
	}

	rule {
		source_labels = ["__journal__transport"]
		target_label  = "transport"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}

	rule {
		source_labels = ["level"]
		regex         = "(emerg|alert|crit)"
		target_label  = "level"
		replacement   = "fatal"
	}

	rule {
		source_labels = ["level"]
		regex         = "err"
		target_label  = "level"
		replacement   = "error"
	}

	rule {
		source_labels = ["level"]
		regex         = "warning"
		target_label  = "level"
		replacement   = "warn"
	}

	rule {
		source_labels = ["level"]
		regex         = "notice"
		target_label  = "level"
		replacement   = "info"
	}
}

loki.source.journal "journal" {
	max_age       = "12h0m0s"
	path          = "/run/log/journal"
	relabel_rules = discovery.relabel.journal.rules
	forward_to    = [loki.write.default.receiver]
	labels        = {
		job = "systemd-journal",
	}
}

// -------------------------------------------------------------------------------- 3. Spark node files

// Spark's own files on the node NVMe, which never reach stdout: JVM GC/safepoint logs and the
// diag*.log appender. Mounted from the host's /mnt/spark-nvme/spark-shuffle (what Spark pods see
// as /mnt/spark-nvme). A static target labelled with this node: Promtail filtered node targets
// by __host__, Alloy does not, so per-node discovery here would tail the same local path once
// per node in the cluster under every node's name.
loki.source.file "spark_node_files" {
	targets = [{
		"__path__"  = "/spark-nvme/{gc-*.log*,diag*.log}",
		"job"       = "spark-node-files",
		"node_name" = sys.env("NODE_NAME"),
		"host_ip"   = sys.env("HOST_IP"),
	}]
	forward_to = [loki.process.spark_node_files.receiver]

	file_match {
		enabled = true
	}
}

loki.process "spark_node_files" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		expression = "/(?P<log_type>gc|diag)[-.]"
		source     = "filename"
	}

	stage.regex {
		expression = "-(?P<spark_role>driver|exec)-"
		source     = "filename"
	}

	stage.replace {
		expression = "^(exec)$"
		source     = "spark_role"
		replace    = "executor"
	}

	stage.regex {
		expression = "\\]\\[(?P<level>trace|debug|info|warning|error)\\]\\["
	}

	stage.regex {
		expression = "^\\S+ (?P<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL) "
	}

	stage.replace {
		expression = "(?i)^(warn|warning)$"
		source     = "level"
		replace    = "warn"
	}

	stage.replace {
		expression = "(?i)^(error)$"
		source     = "level"
		replace    = "error"
	}

	stage.replace {
		expression = "(?i)^(info)$"
		source     = "level"
		replace    = "info"
	}

	stage.replace {
		expression = "(?i)^(debug)$"
		source     = "level"
		replace    = "debug"
	}

	stage.replace {
		expression = "(?i)^(trace)$"
		source     = "level"
		replace    = "trace"
	}

	stage.replace {
		expression = "(?i)^(fatal)$"
		source     = "level"
		replace    = "fatal"
	}

	stage.labels {
		values = {
			level      = null,
			log_type   = null,
			spark_role = null,
		}
	}
}

// -------------------------------------------------------------------------------- 4. Hubble flows

// Cilium's flow export (terraform-aws-k8s-ha cilium.tf, export.static), one JSON object per line:
// {"flow":{...,"verdict":"FORWARDED","drop_reason_desc":...},"node_name":...,"time":...}.
// Every flow is still archived to S3 by hubble-flow-shipper (Fluent Bit), unchanged. Here:
//   * every flow is counted, by verdict and drop reason, into Prometheus;
//   * only non-FORWARDED flows (DROPPED, ERROR, AUDIT, ...) go to Loki. Forwarded flows are
//     overwhelmingly shuffle and S3 traffic at ~100 KB/s/node idle, far more under SF1000, and
//     would compete with Spark logs for Loki's 16 MB/s per-tenant ingest limit.
loki.source.file "hubble" {
	targets = [{
		"__path__"  = "/var/run/cilium/hubble/events.log",
		"job"       = "hubble",
		"node_name" = sys.env("NODE_NAME"),
	}]
	forward_to = [loki.process.hubble.receiver]

	// Re-glob every few seconds. Without file_match a path that does not exist yet is
	// "skipped" once and never retried -- and on a fresh Karpenter node Alloy can start before
	// Cilium writes its first flow, which would silence Hubble on that node for its lifetime.
	file_match {
		enabled     = true
		sync_period = "5s"
	}
}

loki.process "hubble" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			verdict     = "flow.verdict",
			drop_reason = "flow.drop_reason_desc",
		}
	}

	stage.labels {
		values = {
			verdict     = null,
			drop_reason = null,
		}
	}

	// Exposed on Alloy's /metrics as hubble_export_flows_total{verdict,drop_reason,node_name},
	// then remote-written by pipeline 6.
	stage.metrics {
		metric.counter {
			name        = "flows_total"
			prefix      = "hubble_export_"
			description = "Hubble flows read from the export file, by verdict and drop reason."
			match_all   = true
			action      = "inc"
		}
	}

	stage.drop {
		source = "verdict"
		value  = "FORWARDED"
	}

	stage.label_drop {
		values = ["filename"]
	}
}

// -------------------------------------------------------------------------------- 5. OTLP

// Comet's native OTel metrics (spark.comet.otel.endpoint, OTLP/HTTP protobuf). The Service in
// front of this DaemonSet has internalTrafficPolicy: Local, so an executor always reaches the
// Alloy on its own node. Traces and logs are not routed anywhere yet: Comet emits neither.
otelcol.receiver.otlp "default" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	timeout = "5s"

	output {
		metrics = [otelcol.exporter.prometheus.default.input]
	}
}

otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.relabel.add_node.receiver]
}

// -------------------------------------------------------------------------------- 6. self metrics

// Alloy's own metrics: loki_write_dropped_entries_total, loki_write_sent_entries_total,
// prometheus_remote_storage_* and the hubble_export_flows_total counters above. The first is
// what verify-run-telemetry.sh reads to prove nothing was dropped on the way to Loki.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_self" {
	targets         = prometheus.exporter.self.alloy.targets
	forward_to      = [prometheus.relabel.add_node.receiver]
	scrape_interval = "15s"
	job_name        = "alloy"
}

// `node` on Alloy's own and Comet's series only -- NOT a remote_write external label. The
// kube-prometheus-stack dashboards filter on cluster="$cluster" (empty: matches only series
// WITHOUT a cluster label) and its node rules join node-exporter series on namespace/pod and
// group_left(node); a label stamped on everything pushed would break both.
prometheus.relabel "add_node" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		target_label = "node"
		replacement  = sys.env("NODE_NAME")
	}
}

// -------------------------------------------------------------------------------- 7. node metrics

// Scraped on the node and PUSHED, instead of pulled by Prometheus: Prometheus on the core
// node loses whatever it had not yet scraped when Karpenter removes a spark node, while Alloy
// keeps scraping until its own SIGTERM -- the last pod to stop -- and its remote-write WAL
// flushes on the way out. The exporters themselves are unchanged (node-exporter with
// --collector.ethtool on ens5|ens6; Cilium's agent and Hubble metrics); only who scrapes
// moved. Their ServiceMonitors are off (values: prometheus-node-exporter.prometheus.monitor,
// monitoring.ciliumServiceMonitors.agentAndHubble) so nothing is ingested twice.
//
// Labels reproduce exactly what prometheus-operator generated from those ServiceMonitors --
// job, instance, namespace, pod, container, service, endpoint (+ node/host_ip/pod_ip for
// Cilium, from its relabelings) -- so the node dashboards, the node.rules recording rules and
// the ENA allowance panels keep working unchanged.
//
// kubelet / cAdvisor stay pulled by Prometheus: kube-prometheus-stack can only drop their
// ServiceMonitor together with the kubelet dashboard and recording rules (kubelet.enabled).
discovery.relabel "node_exporter" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
		regex         = "prometheus-node-exporter;http-metrics"
		action        = "keep"
	}

	rule {
		target_label = "job"
		replacement  = "node-exporter"
	}

	rule {
		source_labels = ["__address__"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		target_label = "service"
		replacement  = "node-exporter"
	}

	rule {
		target_label = "endpoint"
		replacement  = "http-metrics"
	}
}

prometheus.scrape "node_exporter" {
	targets         = discovery.relabel.node_exporter.output
	forward_to      = [prometheus.remote_write.default.receiver]
	scrape_interval = "30s"
	job_name        = "node-exporter"
}

// Cilium agent (container port "prometheus", 9962; Service cilium-agent, port "metrics") and
// Hubble (container port "hubble-metrics", 9965; Service hubble-metrics) -- both served by the
// per-node cilium pod (k8s-app=cilium). honor_labels as in the ServiceMonitors.
discovery.relabel "cilium" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_k8s_app", "__meta_kubernetes_pod_container_port_name"]
		regex         = "cilium;(prometheus|hubble-metrics)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "prometheus"
		target_label  = "job"
		replacement   = "cilium-agent"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "prometheus"
		target_label  = "endpoint"
		replacement   = "metrics"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "hubble-metrics"
		target_label  = "job"
		replacement   = "hubble-metrics"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "hubble-metrics"
		target_label  = "endpoint"
		replacement   = "hubble-metrics"
	}

	rule {
		source_labels = ["job"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__address__"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_host_ip"]
		target_label  = "host_ip"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_ip"]
		target_label  = "pod_ip"
	}
}

prometheus.scrape "cilium" {
	targets         = discovery.relabel.cilium.output
	forward_to      = [prometheus.remote_write.default.receiver]
	scrape_interval = "30s"
	honor_labels    = true
	job_name        = "cilium"
}

// -------------------------------------------------------------------------------- outputs

loki.write "default" {
	endpoint {
		url        = "http://loki.default.svc.cluster.local:3100/loki/api/v1/push"
		batch_wait = "1s"
		batch_size = "1MiB"

		// Give up on a batch within ~1 min rather than Loki's default of minutes of backoff:
		// a spark node lives ~3 min after the job ends, and a batch still retrying when the
		// node goes is lost anyway -- better it is counted in loki_write_dropped_entries_total
		// while the node is still being scraped.
		max_backoff_period  = "10s"
		max_backoff_retries = 8
	}

	external_labels = {
		cluster = "k8s-ha-cluster",
	}
}

// Both HA replicas, written independently, so each holds every sample and Thanos keeps
// deduplicating on prometheus_replica. The WAL lives under --storage.path (hostPath
// /var/lib/alloy), so an Alloy restart resends rather than drops. No external_labels: see
// prometheus.relabel "add_node".
prometheus.remote_write "default" {
	endpoint {
		url = "http://prometheus-kube-prometheus-stack-prometheus-0.prometheus-operated.default.svc.cluster.local:9090/api/v1/write"
	}

	endpoint {
		url = "http://prometheus-kube-prometheus-stack-prometheus-1.prometheus-operated.default.svc.cluster.local:9090/api/v1/write"
	}
}
