// Grafana Alloy -- the single node agent. Rendered into ConfigMap kube-system/alloy-config by
// charts/monitoring/templates/alloy-config.yaml and run by the `alloy` subchart as a DaemonSet.
//
// Pipelines (each section below):
//   1. pod logs            -> Loki   (replaces Promtail; labels kept identical)
//   2. systemd journal     -> Loki
//   3. Spark GC/diag files -> Loki   (node disk, /mnt/spark-nvme/spark-shuffle)
//   4. (main: Hubble flows -- removed on RKE2/Canal, there is no Hubble)
//   5. OTLP (any OTel SDK) -> metrics to Prometheus; traces to Tempo, plus span metrics with
//                             trace_id exemplars to Prometheus
//   6. Alloy's own metrics -> Prometheus (delivery health: dropped/failed entries, WAL lag)
//   7. node-exporter metrics, scraped on this node -> Prometheus
//
// Env from the pod spec: NODE_NAME (spec.nodeName), HOST_IP (status.hostIP).
//
// Everything here ships continuously (Loki batch_wait 1s, remote-write WAL on hostPath), so
// nothing depends on the SIGTERM flush; that is only the backstop, inside kubelet's 60 s
// critical-pod window.

// -------------------------------------------------------------------------------- 1. pod logs

// Pods on THIS node only. NODE_NAME, not HOSTNAME: with hostNetwork, HOSTNAME is the host's
// name, which need not equal spec.nodeName (RKE2 lowercases it and `node-name` can override
// it); a mismatch would select no pods at all.
//
// Terminal pods stay in this list as long as their objects exist, so a finished executor's file
// is read to the end -- provided the pod is not deleted first. The Spark jobs set
// spark.kubernetes.executor.deleteOnTermination=false for exactly that reason: deleting the pod
// removes /var/log/pods/<pod>/ and drops the target, losing any unread tail.
discovery.kubernetes "pods" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_controller_name"]
		regex         = "([0-9a-z-.]+?)(-[0-9a-f]{8,10})?"
		target_label  = "__tmp_controller_name"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app", "__tmp_controller_name", "__meta_kubernetes_pod_name"]
		regex         = "^;*([^;]+)(;.*)?$"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance", "__meta_kubernetes_pod_label_instance"]
		regex         = "^;*([^;]+)(;.*)?$"
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component", "__meta_kubernetes_pod_label_component"]
		regex         = "^;*([^;]+)(;.*)?$"
		target_label  = "component"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node_name"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["namespace", "app"]
		separator     = "/"
		target_label  = "job"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}

	// Static pods: the log directory is keyed by the config hash, not the API UID.
	rule {
		source_labels = ["__meta_kubernetes_pod_annotationpresent_kubernetes_io_config_hash", "__meta_kubernetes_pod_annotation_kubernetes_io_config_hash", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		regex         = "true/(.*)"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_spark_role"]
		target_label  = "spark_role"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_spark_app_selector"]
		target_label  = "spark_app_selector"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_tier"]
		target_label  = "tier"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_ip"]
		target_label  = "pod_ip"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_host_ip"]
		target_label  = "host_ip"
	}
}

loki.source.file "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.process.pods.receiver]

	file_match {
		enabled = true
	}
}

loki.process "pods" {
	forward_to = [loki.write.default.receiver]

	stage.cri { }

	// max_wait_time flushes a buffered multiline block after 3 s of silence -- without it the
	// last block of a pod that just exited would wait for a next line that never comes.
	stage.match {
		selector = "{spark_role=~\"driver|executor\"}"

		stage.multiline {
			firstline     = "^(\\{|\\d{2}/\\d{2}/\\d{2})"
			max_wait_time = "3s"
		}
	}

	stage.match {
		selector = "{app=\"spark-history-server\"}"

		stage.multiline {
			firstline     = "^\\d{2}/\\d{2}/\\d{2}"
			max_wait_time = "3s"
		}
	}

	stage.match {
		selector = "{tier=\"airflow\"}"

		stage.multiline {
			firstline     = "^\\[\\d{4}-\\d{2}-\\d{2}"
			max_wait_time = "3s"
		}
	}

	stage.match {
		selector = "{app=\"gravitino-helm\"}"

		stage.multiline {
			firstline     = "^\\d{4}-\\d{2}-\\d{2}"
			max_wait_time = "3s"
		}
	}

	// Log level, from whichever of the platform's log formats the line is in.
	stage.regex {
		expression = "^\\S+[ T]\\S+ +(?P<level>TRACE|DEBUG|INFO|WARN|WARNING|ERROR|FATAL)\\b"
	}

	stage.regex {
		expression = "^\\[[^\\]]+\\] \\{[^}]*\\} (?P<level>[A-Z]+) - "
	}

	stage.regex {
		expression = "^\\d{2}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2} (?P<level>[A-Z]+) "
	}

	stage.regex {
		expression = "^(?P<level>[IWEF])\\d{4} \\d{2}:\\d{2}:\\d{2}"
	}

	stage.regex {
		expression = "^\\[\\d{4}/\\d{2}/\\d{2} [\\d:]+\\] \\[ *(?P<level>[a-z]+)\\]"
	}

	stage.regex {
		expression = "^\\S+ \\[(?P<level>[a-z]+) *\\] "
	}

	stage.regex {
		expression = "(?:^|\\s)level=(?P<level>[A-Za-z]+)"
	}

	stage.regex {
		expression = "\"(?:level|severity|lvl|levelname)\"\\s*:\\s*\"(?P<level>[A-Za-z]+)\""
	}

	stage.match {
		selector = "{app=\"k8s-event-exporter\"}"

		stage.json {
			expressions = {
				event_kind      = "involvedObject.kind",
				event_namespace = "involvedObject.namespace",
				event_reason    = "reason",
				level           = "type",
			}
		}

		stage.labels {
			values = {
				event_kind      = null,
				event_namespace = null,
				event_reason    = null,
			}
		}
	}

	stage.replace {
		expression = "(?i)^(t|trace)$"
		source     = "level"
		replace    = "trace"
	}

	stage.replace {
		expression = "(?i)^(d|debug)$"
		source     = "level"
		replace    = "debug"
	}

	stage.replace {
		expression = "(?i)^(i|info|information|notice|normal)$"
		source     = "level"
		replace    = "info"
	}

	stage.replace {
		expression = "(?i)^(w|warn|warning)$"
		source     = "level"
		replace    = "warn"
	}

	stage.replace {
		expression = "(?i)^(e|err|error)$"
		source     = "level"
		replace    = "error"
	}

	stage.replace {
		expression = "(?i)^(f|fatal|crit|critical|panic|alert|emerg)$"
		source     = "level"
		replace    = "fatal"
	}

	stage.labels {
		values = {
			level = null,
		}
	}
}

// -------------------------------------------------------------------------------- 2. journal

// No `path`: the journal reader then opens the system default locations, both the persistent
// /var/log/journal (most on-prem distros; mounted via the varlog mount) and the volatile
// /run/log/journal. node_name is this pod's node, matching the pod streams' node_name label --
// not the journal hostname, which RKE2 may lowercase or override.
discovery.relabel "journal" {
	targets = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "syslog_identifier"
	}

	rule {
		source_labels = ["__journal__transport"]
		target_label  = "transport"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}

	rule {
		source_labels = ["level"]
		regex         = "(emerg|alert|crit)"
		target_label  = "level"
		replacement   = "fatal"
	}

	rule {
		source_labels = ["level"]
		regex         = "err"
		target_label  = "level"
		replacement   = "error"
	}

	rule {
		source_labels = ["level"]
		regex         = "warning"
		target_label  = "level"
		replacement   = "warn"
	}

	rule {
		source_labels = ["level"]
		regex         = "notice"
		target_label  = "level"
		replacement   = "info"
	}
}

loki.source.journal "journal" {
	max_age       = "12h0m0s"
	relabel_rules = discovery.relabel.journal.rules
	forward_to    = [loki.write.default.receiver]
	labels        = {
		job       = "systemd-journal",
		node_name = sys.env("NODE_NAME"),
	}
}

// -------------------------------------------------------------------------------- 3. Spark node files

// Spark's own files on the node disk, which never reach stdout: JVM GC/safepoint logs and the
// diag*.log appender. Mounted from the host's /mnt/spark-nvme/spark-shuffle (what Spark pods see
// as /mnt/spark-nvme). A static target labelled with this node: Promtail filtered node targets
// by __host__, Alloy does not, so per-node discovery here would tail the same local path once
// per node in the cluster under every node's name.
loki.source.file "spark_node_files" {
	targets = [{
		"__path__"  = "/spark-nvme/{gc-*.log*,diag*.log}",
		"job"       = "spark-node-files",
		"node_name" = sys.env("NODE_NAME"),
		"host_ip"   = sys.env("HOST_IP"),
	}]
	forward_to = [loki.process.spark_node_files.receiver]

	file_match {
		enabled = true
	}
}

loki.process "spark_node_files" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		expression = "/(?P<log_type>gc|diag)[-.]"
		source     = "filename"
	}

	stage.regex {
		expression = "-(?P<spark_role>driver|exec)-"
		source     = "filename"
	}

	stage.replace {
		expression = "^(exec)$"
		source     = "spark_role"
		replace    = "executor"
	}

	stage.regex {
		expression = "\\]\\[(?P<level>trace|debug|info|warning|error)\\]\\["
	}

	stage.regex {
		expression = "^\\S+ (?P<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL) "
	}

	stage.replace {
		expression = "(?i)^(warn|warning)$"
		source     = "level"
		replace    = "warn"
	}

	stage.replace {
		expression = "(?i)^(error)$"
		source     = "level"
		replace    = "error"
	}

	stage.replace {
		expression = "(?i)^(info)$"
		source     = "level"
		replace    = "info"
	}

	stage.replace {
		expression = "(?i)^(debug)$"
		source     = "level"
		replace    = "debug"
	}

	stage.replace {
		expression = "(?i)^(trace)$"
		source     = "level"
		replace    = "trace"
	}

	stage.replace {
		expression = "(?i)^(fatal)$"
		source     = "level"
		replace    = "fatal"
	}

	stage.labels {
		values = {
			level      = null,
			log_type   = null,
			spark_role = null,
		}
	}
}

// -------------------------------------------------------------------------------- 5. OTLP

// OTLP metrics and traces from any OpenTelemetry SDK/agent (HTTP :4318 or gRPC :4317). The
// Service in front of this DaemonSet (alloy.kube-system.svc) has internalTrafficPolicy: Local,
// so a pod always reaches the Alloy on its own node. Logs are not taken over OTLP: stdout/stderr
// is collected by pipeline 1.
otelcol.receiver.otlp "default" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
		traces  = [otelcol.processor.batch.traces.input]
	}
}

// Spans arrive in bursts at stage boundaries (one per operator per task, ~80 attributes each),
// so batch larger than the metrics path before the network hop to Tempo.
otelcol.processor.batch "traces" {
	timeout         = "2s"
	send_batch_size = 2048

	output {
		traces = [otelcol.exporter.otlp.tempo.input, otelcol.connector.spanmetrics.default.input]
	}
}

// charts/monitoring/templates/tempo.yaml. The sending queue absorbs a stage's burst while Tempo
// flushes; when it overflows, spans are dropped here and counted in
// otelcol_exporter_enqueue_failed_spans -- never back-pressure on an executor.
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo.default.svc.cluster.local:4317"

		tls {
			insecure = true
		}
	}

	sending_queue {
		queue_size = 20000
	}
}

// Per span name --
// a call counter and a duration histogram, with trace_id exemplars so a Grafana latency panel
// links straight to a trace. Default dimensions only (service.name, span.name, span.kind,
// status.code): pod or stage dimensions would mint a series per task. Covers sampled queries
// only, and a span's duration includes time waiting on its children.
otelcol.connector.spanmetrics "default" {
	histogram {
		explicit {
			buckets = ["10ms", "50ms", "100ms", "500ms", "1s", "5s", "15s", "30s", "60s", "120s", "300s"]
		}
	}

	exemplars {
		max_per_data_point = 5
	}

	metrics_flush_interval = "15s"

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	timeout = "5s"

	output {
		metrics = [otelcol.exporter.prometheus.default.input]
	}
}

otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.relabel.add_node.receiver]
}

// -------------------------------------------------------------------------------- 6. self metrics

// Alloy's own metrics: loki_write_dropped_entries_total, loki_write_sent_entries_total and
// prometheus_remote_storage_* -- the first proves nothing was dropped on the way to Loki.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_self" {
	targets         = prometheus.exporter.self.alloy.targets
	forward_to      = [prometheus.relabel.add_node.receiver]
	scrape_interval = "15s"
	job_name        = "alloy"
}

// `node` on Alloy's own and OTLP series only -- NOT a remote_write external label. The
// kube-prometheus-stack dashboards filter on cluster="$cluster" (empty: matches only series
// WITHOUT a cluster label) and its node rules join node-exporter series on namespace/pod and
// group_left(node); a label stamped on everything pushed would break both.
prometheus.relabel "add_node" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		target_label = "node"
		replacement  = sys.env("NODE_NAME")
	}
}

// -------------------------------------------------------------------------------- 7. node metrics

// Scraped on the node and PUSHED, instead of pulled by Prometheus: Alloy keeps scraping until
// its own SIGTERM -- the last pod to stop -- and its remote-write WAL flushes on the way out.
// node-exporter's ServiceMonitor is off (values: prometheus-node-exporter.prometheus.monitor)
// so nothing is ingested twice.
//
// Labels reproduce exactly what prometheus-operator generated from that ServiceMonitor --
// job, instance, namespace, pod, container, service, endpoint -- so the node dashboards and
// the node.rules recording rules keep working unchanged.
//
// kubelet / cAdvisor stay pulled by Prometheus: kube-prometheus-stack can only drop their
// ServiceMonitor together with the kubelet dashboard and recording rules (kubelet.enabled).
discovery.relabel "node_exporter" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
		regex         = "prometheus-node-exporter;http-metrics"
		action        = "keep"
	}

	rule {
		target_label = "job"
		replacement  = "node-exporter"
	}

	rule {
		source_labels = ["__address__"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		target_label = "service"
		replacement  = "node-exporter"
	}

	rule {
		target_label = "endpoint"
		replacement  = "http-metrics"
	}
}

prometheus.scrape "node_exporter" {
	targets         = discovery.relabel.node_exporter.output
	forward_to      = [prometheus.remote_write.default.receiver]
	scrape_interval = "30s"
	job_name        = "node-exporter"
}

// -------------------------------------------------------------------------------- outputs

loki.write "default" {
	endpoint {
		url        = "http://loki.default.svc.cluster.local:3100/loki/api/v1/push"
		batch_wait = "1s"
		batch_size = "1MiB"

		// Give up on a batch within ~1 min rather than Loki's default of minutes of backoff,
		// so a stuck push is counted in loki_write_dropped_entries_total instead of silently
		// backing up the pipeline.
		max_backoff_period  = "10s"
		max_backoff_retries = 8
	}

	external_labels = {
		cluster = "rke2-bigdata",
	}
}

// Both HA replicas, written independently, so each holds every sample and Thanos keeps
// deduplicating on prometheus_replica. The WAL lives under --storage.path (hostPath
// /var/lib/alloy), so an Alloy restart resends rather than drops. No external_labels: see
// prometheus.relabel "add_node".
prometheus.remote_write "default" {
	endpoint {
		url = "http://prometheus-kube-prometheus-stack-prometheus-0.prometheus-operated.default.svc.cluster.local:9090/api/v1/write"
	}

	endpoint {
		url = "http://prometheus-kube-prometheus-stack-prometheus-1.prometheus-operated.default.svc.cluster.local:9090/api/v1/write"
	}
}
