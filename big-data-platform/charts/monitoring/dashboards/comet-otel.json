{
  "uid": "comet-otel",
  "title": "Comet OTel: traces, per-query metrics, runtime",
  "tags": [
    "comet",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "query",
        "label": "Query",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(spark_tasks_total, query)",
        "query": {
          "query": "label_values(spark_tasks_total, query)",
          "refId": "q"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 3
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Run overview (selected queries)",
      "collapsed": false,
      "panels": [],
