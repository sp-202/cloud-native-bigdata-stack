# =============================================================================
# Spark Image Configuration
# =============================================================================
# Spark version (e.g., 4.0.1)
SPARK_VERSION=4.0.1

# Unity Catalog version (e.g., 0.4.0)
UNITY_CATALOG_VERSION=0.4.0

# Image version tag (e.g., v8-sedona-h3)
SPARK_IMAGE_VERSION=v9-sedona-h3

# Resulting image name (computed from above variables)
# SPARK_IMAGE=subhodeep2022/spark-bigdata:spark-${SPARK_VERSION}-uc-${UNITY_CATALOG_VERSION}-${SPARK_IMAGE_VERSION}
