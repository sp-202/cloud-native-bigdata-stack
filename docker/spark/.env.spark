# =============================================================================
# Spark Image Configuration (rke2 branch)
# =============================================================================
# Spark version (e.g., 3.5.8) — stock Apache binary, Hadoop 3 / Scala 2.13
SPARK_VERSION=3.5.8

# Gravitino Spark connector version
GRAVITINO_VERSION=1.2.0

# Image version tag. No Comet on this branch; the "-oss" marks the stock-Spark build so it
# never overwrites main's Comet image tags. v14 adds the Kafka connector.
SPARK_IMAGE_VERSION=v14-iceberg-gravitino-kafka-oss

# Target platform(s) for buildx — the RKE2 nodes are x86_64.
SPARK_PLATFORMS=linux/amd64

# Resulting image name (computed in build.sh and the CI job):
# subhodeep2022/spark-bigdata:spark-${SPARK_VERSION}-${SPARK_IMAGE_VERSION}
