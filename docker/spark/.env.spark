# =============================================================================
# Spark Image Configuration
# =============================================================================
# Spark version (e.g., 3.5.8)
SPARK_VERSION=3.5.8

# Unity Catalog version (e.g., 0.4.0)
GRAVITINO_VERSION=1.2.0

# Image version tag (e.g., v8-sedona-h3)
SPARK_IMAGE_VERSION=v12-iceberg-gravitino

# Resulting image name (computed in build.sh)
# SPARK_IMAGE=subhodeep2022/spark-bigdata:spark-${SPARK_VERSION}-${SPARK_IMAGE_VERSION}
