# =============================================================================
# Hive Image Configuration
# =============================================================================
# Hive version — 3.1.3 used for Spark 4.0 compatibility (Hive 2.3 client)
# NOTE: 4.1.0 was ARM64-native but incompatible with Spark's hive-metastore-2.3.10
#       (get_table removed from HMS 4.x standalone Thrift processor)
HIVE_VERSION=3.1.3

# Hive image version tag
HIVE_IMAGE_VERSION_TAG=arm64-v1

# Resulting image name (computed from above variables)
# HIVE_IMAGE=subhodeep2022/spark-bigdata:hive-${HIVE_VERSION}-${HIVE_IMAGE_VERSION_TAG}
