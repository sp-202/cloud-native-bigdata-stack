# =============================================================================
# RKE2 cluster settings — copy to rke2/cluster.env (gitignored) and edit.
# Read by install-cluster.sh, bootstrap-platform.sh and uninstall.sh.
# =============================================================================

# --- Nodes ("name:ip", space separated) --------------------------------------
# 4 identical x86_64 nodes (16 GB RAM / 20 cores each): 3 servers (etcd
# quorum survives one server loss) + 1 agent. The servers also run the
# platform — RKE2 servers are not tainted by default. The FIRST server
# initialises the cluster. Names become the Kubernetes node names.
SERVER_NODES="node-01:192.168.1.11 node-02:192.168.1.12 node-03:192.168.1.13"
AGENT_NODES="node-04:192.168.1.14"

# Node given entirely to StarRocks (FE + BE): labelled
# node-role.kubernetes.io/starrocks= and tainted dedicated=starrocks:NoSchedule
# by install-cluster.sh. Use the agent, so etcd/control plane never compete
# with StarRocks for memory. Empty = no dedicated node (then also drop the
# nodeSelector/tolerations in values.yaml starrocks block).
STARROCKS_NODE="node-04"

# Held back from Kubernetes on every node for the OS + kubelet/containerd
# (kubelet system-reserved + kube-reserved + hard-eviction threshold).
# Defaults sum to 2 GiB RAM / 1.5 cores — what's left is allocatable to pods.
SYSTEM_RESERVED="cpu=1,memory=1Gi"
KUBE_RESERVED="cpu=500m,memory=768Mi"
EVICTION_HARD="memory.available<256Mi,nodefs.available<10%,imagefs.available<15%"

# --- SSH (from this machine to every node) -----------------------------------
# The user needs passwordless sudo on the nodes.
SSH_USER="ubuntu"
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PORT="22"

# --- RKE2 ---------------------------------------------------------------------
# Release channel (https://update.rke2.io/v1-release/channels) or an exact
# version; RKE2_VERSION wins when set. Best practice: pin RKE2_VERSION (e.g.
# "v1.36.5+rke2r1", see github.com/rancher/rke2/releases) so every node — and
# a node added months later — runs the same build; upgrade deliberately.
# A pinned version is downloaded once (server 1) and copied to the others.
RKE2_CHANNEL="stable"
RKE2_VERSION="v1.36.5+rke2r1"
# NIC carrying node-to-node traffic, if the nodes have more than one
# (e.g. "ens18"). Empty = the interface holding the node IP above.
CANAL_IFACE=""
# Open firewalld/ufw on the nodes? RKE2+Canal recommends turning firewalld off;
# "disable" stops firewalld/ufw, "keep" leaves them (you must open the ports
# listed in rke2/README.md yourself).
NODE_FIREWALL="disable"

# --- Ingress -------------------------------------------------------------------
# The node IP baked into every hostname: grafana.<INGRESS_IP>.sslip.io etc.,
# and the MQTT endpoint for the DCS bridge: <INGRESS_IP>:1883. Traefik runs on
# every node except the StarRocks one — pick one of node-01..03.
INGRESS_IP="192.168.1.11"

# --- Storage (OpenEBS local PV behind StorageClass `local-storage`) ------------
# hostpath: a directory per PVC under HOSTPATH_BASE. No disk prep, sizes not
#           enforced. Good default.
# lvm:      CSI local.csi.openebs.io, a logical volume per PVC from volume group
#           LVM_VG on every node: enforced sizes, ext4, snapshots, expansion.
#           prep-node.sh creates LVM_VG from LVM_DEVICES (an EMPTY disk/partition,
#           e.g. "/dev/sdb") if the VG doesn't exist yet. Refuses a device that
#           has a partition table or filesystem signature.
# Pick before the first bootstrap: an existing StorageClass can't change backend.
STORAGE_BACKEND="hostpath"
HOSTPATH_BASE="/var/openebs/local"
LVM_VG="openebs-vg"
LVM_DEVICES=""

# Spark shuffle/spill directory on every node (hostPath used by Spark executors
# and read by Alloy). Bind-mount or symlink it onto your fastest disk if the
# root disk is slow.
SPARK_LOCAL_DIR="/mnt/spark-nvme/spark-shuffle"

# --- GitOps --------------------------------------------------------------------
GIT_REPO="https://github.com/sp-202/cloud-native-bigdata-stack.git"
GIT_REVISION="rke2"

# --- Local output --------------------------------------------------------------
# Kubeconfig written by install-cluster.sh (server 1's API, admin).
KUBECONFIG_OUT="rke2/kubeconfig"
