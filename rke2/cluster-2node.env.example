# =============================================================================
# 2-node TEST cluster — copy to rke2/cluster-2node.env (gitignored) and run
# every script with it:
#   export CLUSTER_ENV=rke2/cluster-2node.env
#   rke2/install-cluster.sh && rke2/bootstrap-platform.sh
# Same scripts and same git branch as the 4-node cluster; only this file
# differs. All settings not listed here behave as documented in
# cluster.env.example.
# =============================================================================

# 1 server + 1 agent. Not 2 servers: a 2-member etcd needs both members for
# quorum, so either node going down freezes the cluster — strictly worse than 1.
SERVER_NODES="node-01:192.168.1.21"
AGENT_NODES="node-02:192.168.1.22"
STARROCKS_NODE=""            # no dedicated StarRocks node (StarRocks is off)

# Test subset: Gravitino, Airflow, Postgres, Prometheus + Grafana, Spark
# Operator (+ SeaweedFS/cert-manager/CNPG they depend on). See
# big-data-platform/values-2node.yaml.
PLATFORM_PROFILE="2node"

SSH_USER="ubuntu"
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PORT="22"

RKE2_CHANNEL="v1.33"
RKE2_VERSION=""
CANAL_IFACE=""
NODE_FIREWALL="disable"

SYSTEM_RESERVED="cpu=1,memory=1Gi"
KUBE_RESERVED="cpu=500m,memory=768Mi"
EVICTION_HARD="memory.available<256Mi,nodefs.available<10%,imagefs.available<15%"

INGRESS_IP="192.168.1.21"

STORAGE_BACKEND="hostpath"
HOSTPATH_BASE="/var/openebs/local"
LVM_VG="openebs-vg"
LVM_DEVICES=""
SPARK_LOCAL_DIR="/mnt/spark-nvme/spark-shuffle"

GIT_REPO="https://github.com/sp-202/cloud-native-bigdata-stack.git"
GIT_REVISION="rke2"

# Separate kubeconfig, so the 4-node cluster's rke2/kubeconfig is untouched.
KUBECONFIG_OUT="rke2/kubeconfig-2node"
