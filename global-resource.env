# =============================================================================
# Global Resource Configuration
# =============================================================================
# Single source of truth for replica counts, CPU/memory resources, and node
# assignments for every deployment in the stack.
#
# Edit this file to tune the entire platform — no need to touch individual
# YAML or Helm values files.
#
# Usage: sourced by deploy-v2.sh before generating/applying manifests.
#   $(VAR) placeholders in YAML files are replaced by sed at deploy time.
#   $(VAR) placeholders in Helm values files are resolved before helm template.
#
# Node roles map to Kubernetes node labels of the form:
#   node-role.kubernetes.io/<NODE_ROLE>: ""
# =============================================================================

# =============================================================================
# NODE ASSIGNMENTS
# =============================================================================
# Change a role name here to move the entire group to a different node.

GP_NODE_ROLE=k8s-gp-node           # postgres, redis, airflow, hive, starrocks, jupyterhub, superset, spark-operator
SPARK_NODE_ROLE=spark-node          # spark-connect-server, spark-history-server
MINIO_NODE_ROLE=minio-worker        # minio  (has a matching NoSchedule taint)
CONTROL_PLANE_NODE_ROLE=control-plane  # prometheus, grafana  (has a matching NoSchedule taint)

# =============================================================================
# DATABASE LAYER
# =============================================================================

# --- PostgreSQL ---
POSTGRES_REPLICAS=1
POSTGRES_CPU_REQUEST=500m
POSTGRES_CPU_LIMIT=1000m
POSTGRES_MEM_REQUEST=1Gi
POSTGRES_MEM_LIMIT=2Gi

# --- MinIO ---
MINIO_REPLICAS=1
MINIO_CPU_REQUEST=500m
MINIO_CPU_LIMIT=1000m
MINIO_MEM_REQUEST=1Gi
MINIO_MEM_LIMIT=2Gi

# --- Redis ---
REDIS_REPLICAS=1
REDIS_CPU_REQUEST=1000m
REDIS_CPU_LIMIT=1500m
REDIS_MEM_REQUEST=2048Mi
REDIS_MEM_LIMIT=3072Mi

# =============================================================================
# APPS LAYER
# =============================================================================

# --- Airflow Webserver ---
AIRFLOW_WEBSERVER_REPLICAS=1
AIRFLOW_WEBSERVER_CPU_REQUEST=500m
AIRFLOW_WEBSERVER_CPU_LIMIT=1000m
AIRFLOW_WEBSERVER_MEM_REQUEST=0.5Gi
AIRFLOW_WEBSERVER_MEM_LIMIT=1Gi

# --- Airflow Scheduler ---
AIRFLOW_SCHEDULER_REPLICAS=1
AIRFLOW_SCHEDULER_CPU_REQUEST=1000m
AIRFLOW_SCHEDULER_CPU_LIMIT=2000m
AIRFLOW_SCHEDULER_MEM_REQUEST=1Gi
AIRFLOW_SCHEDULER_MEM_LIMIT=1.5Gi

# --- Spark Connect Server ---
SPARK_CONNECT_REPLICAS=1
SPARK_CONNECT_CPU_REQUEST=500m
SPARK_CONNECT_CPU_LIMIT=1000m
SPARK_CONNECT_MEM_REQUEST=1Gi
SPARK_CONNECT_MEM_LIMIT=2Gi

# --- Spark History Server ---
SPARK_HISTORY_REPLICAS=1
SPARK_HISTORY_CPU_REQUEST=1000m
SPARK_HISTORY_CPU_LIMIT=1500m
SPARK_HISTORY_MEM_REQUEST=1Gi
SPARK_HISTORY_MEM_LIMIT=1.5Gi

# --- JupyterHub ---
JUPYTERHUB_REPLICAS=1
JUPYTERHUB_CPU_REQUEST=500m
JUPYTERHUB_CPU_LIMIT=1000m
JUPYTERHUB_MEM_REQUEST=1Gi
JUPYTERHUB_MEM_LIMIT=2Gi

# --- Hive Metastore (main container) ---
HIVE_REPLICAS=1
HIVE_METASTORE_CPU_REQUEST=500m
HIVE_METASTORE_CPU_LIMIT=1000m
HIVE_METASTORE_MEM_REQUEST=1Gi
HIVE_METASTORE_MEM_LIMIT=2Gi

# --- Hive Server2 (sidecar container) ---
HIVE_SERVER_CPU_REQUEST=500m
HIVE_SERVER_CPU_LIMIT=1000m
HIVE_SERVER_MEM_REQUEST=1Gi
HIVE_SERVER_MEM_LIMIT=2Gi

# --- StarRocks Frontend ---
STARROCKS_FE_REPLICAS=1
STARROCKS_FE_CPU_REQUEST=500m
STARROCKS_FE_CPU_LIMIT=2000m
STARROCKS_FE_MEM_REQUEST=2Gi
STARROCKS_FE_MEM_LIMIT=4Gi

# --- StarRocks Backend ---
STARROCKS_BE_REPLICAS=1
STARROCKS_BE_CPU_REQUEST=500m
STARROCKS_BE_CPU_LIMIT=2000m
STARROCKS_BE_MEM_REQUEST=2Gi
STARROCKS_BE_MEM_LIMIT=4Gi

# =============================================================================
# SUPERSET (Helm chart — values resolved before helm template)
# =============================================================================

# Superset web server (supersetNode)
SUPERSET_NODE_REPLICAS=2
SUPERSET_NODE_CPU_REQUEST=1000m
SUPERSET_NODE_CPU_LIMIT=2000m
SUPERSET_NODE_MEM_REQUEST=2Gi
SUPERSET_NODE_MEM_LIMIT=4Gi

# Superset Celery worker (supersetWorker)
SUPERSET_WORKER_REPLICAS=2
SUPERSET_WORKER_CPU_REQUEST=1000m
SUPERSET_WORKER_CPU_LIMIT=2000m
SUPERSET_WORKER_MEM_REQUEST=2Gi
SUPERSET_WORKER_MEM_LIMIT=4Gi

# Superset Celery Beat scheduler
SUPERSET_BEAT_CPU_REQUEST=250m
SUPERSET_BEAT_CPU_LIMIT=500m
SUPERSET_BEAT_MEM_REQUEST=256Mi
SUPERSET_BEAT_MEM_LIMIT=512Mi

# Superset init Job
SUPERSET_INIT_CPU_REQUEST=500m
SUPERSET_INIT_CPU_LIMIT=1000m
SUPERSET_INIT_MEM_REQUEST=1Gi
SUPERSET_INIT_MEM_LIMIT=2Gi

# =============================================================================
# MONITORING LAYER (Helm charts — values resolved before helm template)
# =============================================================================

# Prometheus storage
PROMETHEUS_STORAGE=10Gi
PROMETHEUS_RETENTION=168h
