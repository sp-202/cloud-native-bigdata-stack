# Secrets (local overrides, never commit)
.env
.env.local

# global-config.env is now committed to Git (needed by ArgoCD/Kustomize)
# If you need to override values locally, edit .env.local instead

# Data directories (should not be in git)
data/
superset_bak/

airflow/logs/*

# Python
__pycache__/
*.pyc

# IDEs
.vscode/
.idea/

# OS
.DS_Store

airflow/*.db
airflow/*.pid

# Ignore k3s auto-downloaded dependencies
k3s/superset/

# Helm chart download caches (ArgoCD/kustomize fetches from repos directly)
k8s-platform-v2/03-apps/charts/
k8s-platform-v2/05-monitoring/charts/

# Helm dependency tarballs — never commit these.
# Local sub-charts (file:// deps, source under charts/*/) must never be
# committed packaged: a stale .tgz would shadow changes to their source.
big-data-platform/charts/*.tgz
# EXCEPT the remote dependencies (Chart.yaml repository: https/oci), vendored
# at their pinned versions. Argo CD runs `helm dependency build` only when a
# dependency is missing, and that build downloads all 10 charts — on a slow
# uplink one failed download fails the whole render (ComparisonError). With
# them in git the render needs no network. Bump = replace the .tgz here too.
!big-data-platform/charts/cloudnative-pg-0.29.0.tgz
!big-data-platform/charts/cert-manager-v1.16.2.tgz
!big-data-platform/charts/spark-operator-2.4.0.tgz
!big-data-platform/charts/kube-starrocks-1.9.8.tgz
!big-data-platform/charts/airflow-1.21.0.tgz
!big-data-platform/charts/kube-prometheus-stack-56.6.2.tgz
!big-data-platform/charts/loki-stack-2.10.2.tgz
!big-data-platform/charts/alloy-1.13.0.tgz
!big-data-platform/charts/gravitino-helm-1.3.11.tgz
!big-data-platform/charts/strimzi-kafka-operator-0.48.0.tgz

# Binaries and Archives
helm
*.tar.gz
linux-amd64/
logs-from-spark*
generated-manifests.yaml

# Claude Code — ignore personal/ephemeral, keep shared config
.claude/
!.claude/settings.json

# graphify generated output (regenerate with 'graphify update .')
big-data-platform/graphify-out/
# Upstream charts pulled locally for schema reference (not deployed from here)
vendor-charts/

# RKE2 bootstrap: local cluster settings and generated kubeconfig (rke2/README.md)
rke2/cluster.env
rke2/kubeconfig*
rke2/cluster-*.env
rke2/*.log

# Local notes with real credentials/addresses (never committed)
*.local.md
rke2/WIFI-SETUP.md
